PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/msc_db?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin seed account (used by seeder.js)
ADMIN_EMAIL=admin@montrealsportscenter.ca
ADMIN_PASSWORD=change_this_password

# Comma-separated list of deployed frontend URLs allowed by CORS
# e.g. https://msc-frontend.vercel.app,https://www.montrealsportscenter.ca
FRONTEND_URL=

# Email notifications (Gmail SMTP via nodemailer, using a Gmail App Password)
EMAIL_USER=
EMAIL_APP_PASSWORD=
NOTIFY_EMAIL=
